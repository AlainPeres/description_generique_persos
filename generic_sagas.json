{
  "system": "sagas",
  "specific_values": {
    "skill_value_meaning": "skill level (associated attribute + learning level)",
    "derived_values": [
      {
        "name": "Learning Levels",
        "applies_to": "skill",
        "computed_from": "skill level - associated attribute"
      },
      {
        "name": "Protection",
        "applies_to": "character",
        "computed_from": "Armor + Abilities (super powers, outside the base rules); 0 by default"
      },
      {
        "name": "MaxImpactBonus",
        "applies_to": "character",
        "computed_from": "2*Protection + Physical Shock Threshold"
      },
      {
        "name": "Physical Hit Points",
        "applies_to": "character",
        "computed_from": "2*(Strength + Will + Endurance)"
      },
      {
        "name": "Psychical Hit Points",
        "applies_to": "character",
        "computed_from": "2*(Presence + Will + Instinct)"
      },
      {
        "name": "Physical Shock Threshold",
        "applies_to": "character",
        "computed_from": "10 + UT Strength bonus"
      },
      {
        "name": "Psychical Shock Threshold",
        "applies_to": "character",
        "computed_from": "10 + UT Presence bonus"
      },
      {
        "name": "Reflex Defense",
        "applies_to": "character",
        "computed_from": "2 + Dodge skill level / 2, rounded down"
      },
      {
        "name": "Initiative Creation Bonus",
        "applies_to": "character",
        "computed_from": "Initiative - (Agility + Wit) / 2, rounded down"
      },
      {
        "name": "Close Combat Creation Bonus",
        "applies_to": "character",
        "computed_from": "Close Combat - (Strength + 2*Agility + Instinct + Will) / 5, rounded down"
      },
      {
        "name": "Ranged Combat Creation Bonus",
        "applies_to": "character",
        "computed_from": "Ranged Combat - (3*Dexterity + 2*Instinct) / 5, rounded down"
      },
      {
        "name": "Speed Creation Bonus",
        "applies_to": "character",
        "computed_from": "Speed - species base (6 for humans) - (Endurance + Agility) / 4, rounded down"
      }
    ],
    "unspent_creation_points": 0
  },
