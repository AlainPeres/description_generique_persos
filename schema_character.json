{
  "$defs": {
    "EquipmentItem": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ItemCategory"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "equipped": {
          "default": false,
          "title": "Equipped",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "required": [
        "name",
        "category"
      ],
      "title": "EquipmentItem",
      "type": "object"
    },
    "ItemCategory": {
      "enum": [
        "weapon",
        "armor",
        "item",
        "consumable"
      ],
      "title": "ItemCategory",
      "type": "string"
    },
    "StatsCthulhu": {
      "properties": {
        "system": {
          "const": "cthulhu",
          "title": "System",
          "type": "string"
        },
        "occupation": {
          "title": "Occupation",
          "type": "string"
        },
        "sanity": {
          "maximum": 99,
          "minimum": 0,
          "title": "Sanity",
          "type": "integer"
        },
        "hit_points": {
          "title": "Hit Points",
          "type": "integer"
        },
        "skills": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Skills",
          "type": "object"
        },
        "spells": {
          "items": {
            "type": "string"
          },
          "title": "Spells",
          "type": "array"
        }
      },
      "required": [
        "system",
        "occupation",
        "sanity",
        "hit_points"
      ],
      "title": "StatsCthulhu",
      "type": "object"
    },
    "StatsDnD": {
      "properties": {
        "system": {
          "const": "dnd5e",
          "title": "System",
          "type": "string"
        },
        "character_class": {
          "title": "Character Class",
          "type": "string"
        },
        "race": {
          "title": "Race",
          "type": "string"
        },
        "level": {
          "maximum": 20,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "strength": {
          "maximum": 20,
          "minimum": 1,
          "title": "Strength",
          "type": "integer"
        },
        "dexterity": {
          "maximum": 20,
          "minimum": 1,
          "title": "Dexterity",
          "type": "integer"
        },
        "constitution": {
          "maximum": 20,
          "minimum": 1,
          "title": "Constitution",
          "type": "integer"
        },
        "intelligence": {
          "maximum": 20,
          "minimum": 1,
          "title": "Intelligence",
          "type": "integer"
        },
        "wisdom": {
          "maximum": 20,
          "minimum": 1,
          "title": "Wisdom",
          "type": "integer"
        },
        "charisma": {
          "maximum": 20,
          "minimum": 1,
          "title": "Charisma",
          "type": "integer"
        },
        "armor_class": {
          "title": "Armor Class",
          "type": "integer"
        },
        "hit_points": {
          "title": "Hit Points",
          "type": "integer"
        },
        "feats": {
          "items": {
            "type": "string"
          },
          "title": "Feats",
          "type": "array"
        },
        "skills": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Skills",
          "type": "object"
        },
        "spells": {
          "items": {
            "type": "string"
          },
          "title": "Spells",
          "type": "array"
        }
      },
      "required": [
        "system",
        "character_class",
        "race",
        "level",
        "strength",
        "dexterity",
        "constitution",
        "intelligence",
        "wisdom",
        "charisma",
        "armor_class",
        "hit_points"
      ],
      "title": "StatsDnD",
      "type": "object"
    }
  },
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "background": {
      "default": "",
      "title": "Background",
      "type": "string"
    },
    "stats": {
      "discriminator": {
        "mapping": {
          "cthulhu": "#/$defs/StatsCthulhu",
          "dnd5e": "#/$defs/StatsDnD"
        },
        "propertyName": "system"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StatsDnD"
        },
        {
          "$ref": "#/$defs/StatsCthulhu"
        }
      ],
      "title": "Stats"
    },
    "equipment": {
      "items": {
        "$ref": "#/$defs/EquipmentItem"
      },
      "title": "Equipment",
      "type": "array"
    }
  },
  "required": [
    "name",
    "stats"
  ],
  "title": "Character",
  "type": "object"
}