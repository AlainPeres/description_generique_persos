{
  "$defs": {
    "Ability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/AbilityCategory"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/SkillCategory",
          "default": "Base"
        }
      },
      "required": [
        "name",
        "category"
      ],
      "title": "Ability",
      "type": "object"
    },
    "AbilityCategory": {
      "enum": [
        "Feat",
        "Origin Ability",
        "Class Ability",
        "Power",
        "Advantage",
        "Disadvantage",
        "Spell"
      ],
      "title": "AbilityCategory",
      "type": "string"
    },
    "Attribute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "Consequence": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Consequence",
      "type": "object"
    },
    "EquipmentItem": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ItemCategory"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "equipped": {
          "default": false,
          "title": "Equipped",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "required": [
        "name",
        "category"
      ],
      "title": "EquipmentItem",
      "type": "object"
    },
    "ItemCategory": {
      "enum": [
        "weapon",
        "armor",
        "item",
        "consumable"
      ],
      "title": "ItemCategory",
      "type": "string"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/SkillCategory"
