            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "system"
      ],
      "title": "SpecificValuesNoRules",
      "type": "object"
    },
    "SpecificValuesSagas": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "sagas",
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "system"
      ],
      "title": "SpecificValuesSagas",
      "type": "object"
    },
    "StressBox": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "checked": {
          "default": false,
          "title": "Checked",
          "type": "boolean"
        }
      },
      "title": "StressBox",
      "type": "object"
    }
