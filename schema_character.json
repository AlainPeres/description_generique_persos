{
  "$defs": {
    "Ability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/AbilityCategory"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/SkillCategory",
          "default": "Base"
        }
      },
      "required": [
        "name",
        "category"
      ],
      "title": "Ability",
      "type": "object"
    },
    "AbilityCategory": {
      "enum": [
        "Feat",
        "Origin Ability",
        "Class Ability",
        "Power",
        "Advantage",
        "Disadvantage",
        "Spell"
      ],
      "title": "AbilityCategory",
      "type": "string"
    },
    "Attribute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/AttributeCategory"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "category",
        "value"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "AttributeCategory": {
      "enum": [
        "Main",
        "Secondary",
        "Talent",
        "State"
      ],
      "title": "AttributeCategory",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "duration": {
          "anyOf": [
            {
              "enum": [
                "temporary",
                "indefinite",
                "permanent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "cured": {
          "default": false,
          "title": "Cured",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "Physical",
        "Mental",
        "Other"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Consequence": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Consequence",
      "type": "object"
    },
    "DerivedValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "applies_to": {
          "anyOf": [
            {
              "enum": [
                "character",
                "skill"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/AttributeCategory"
            }
          ],
          "default": "character",
          "title": "Applies To"
        },
        "computed_from": {
          "title": "Computed From",
          "type": "string"
        }
      },
      "required": [
        "name",
        "computed_from"
      ],
      "title": "DerivedValue",
      "type": "object"
    },
    "DnDClass": {
