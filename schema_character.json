    "specific_values": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "cthulhu6": "#/$defs/SpecificValuesCthulhu",
              "dnd5e": "#/$defs/SpecificValuesDnD",
              "fate": "#/$defs/SpecificValuesFate",
              "norules": "#/$defs/SpecificValuesNoRules",
              "sagas": "#/$defs/SpecificValuesSagas"
            },
            "propertyName": "system"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SpecificValuesDnD"
            },
            {
              "$ref": "#/$defs/SpecificValuesCthulhu"
            },
            {
              "$ref": "#/$defs/SpecificValuesFate"
            },
            {
              "$ref": "#/$defs/SpecificValuesSagas"
            },
            {
              "$ref": "#/$defs/SpecificValuesNoRules"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
