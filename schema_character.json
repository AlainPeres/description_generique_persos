    "Skill": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/SkillCategory"
        },
        "value": {
          "title": "Value",
          "type": "integer"
