          "title": "Speed",
          "type": "object"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        }
      },
      "required": [
        "system",
        "character_class",
        "race",
        "level",
        "alignment"
      ],
      "title": "SpecificValuesDnD",
      "type": "object"
    },
    "SpecificValuesFate": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "fate",
          "title": "System",
          "type": "string"
        },
        "HighConcept": {
          "title": "Highconcept",
          "type": "string"
        },
        "Trouble": {
          "title": "Trouble",
          "type": "string"
        },
        "Aspects": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Aspects",
          "type": "array"
        },
        "Extras": {
          "items": {
            "type": "string"
          },
          "title": "Extras",
          "type": "array"
        },
        "FatePoints": {
          "title": "Fatepoints",
          "type": "integer"
        },
        "Refresh": {
          "title": "Refresh",
          "type": "integer"
        },
        "PhysicalStress": {
          "additionalProperties": {
            "$ref": "#/$defs/StressBox"
          },
          "maxProperties": 4,
          "title": "Physicalstress",
          "type": "object"
        },
        "MentalStress": {
          "additionalProperties": {
            "$ref": "#/$defs/StressBox"
          },
          "maxProperties": 4,
          "title": "Mentalstress",
          "type": "object"
        },
        "Consequences": {
          "additionalProperties": {
            "$ref": "#/$defs/Consequence"
          },
          "maxProperties": 5,
          "title": "Consequences",
          "type": "object"
