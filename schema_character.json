    "SpecificValuesCthulhu": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "cthulhu6",
          "title": "System",
          "type": "string"
        },
        "skill_value_meaning": {
          "const": "percentage",
          "default": "percentage",
          "title": "Skill Value Meaning",
          "type": "string"
        },
        "derived_values": {
          "default": [
            {
              "name": "Idea",
              "applies_to": "character",
              "computed_from": "Intelligence x 5"
            },
            {
              "name": "Luck",
              "applies_to": "character",
              "computed_from": "Power x 5"
            },
            {
              "name": "Know",
              "applies_to": "character",
              "computed_from": "Education x 5"
            },
            {
              "name": "Damage Bonus",
              "applies_to": "character",
              "computed_from": "Strength + Size, damage bonus table"
            },
            {
              "name": "Maximum Sanity",
              "applies_to": "character",
              "computed_from": "99 - Cthulhu Mythos"
            },
            {
              "name": "Maximum Hit Points",
              "applies_to": "character",
              "computed_from": "(Constitution + Size) / 2, rounded up"
            },
            {
              "name": "Maximum Magic Points",
              "applies_to": "character",
              "computed_from": "Power"
            }
          ],
          "items": {
            "$ref": "#/$defs/DerivedValue"
          },
          "title": "Derived Values",
          "type": "array"
        }
      },
      "required": [
        "system"
      ],
      "title": "SpecificValuesCthulhu",
      "type": "object"
    },
    "SpecificValuesDaredevils": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "daredevils",
          "title": "System",
          "type": "string"
        },
        "skill_value_meaning": {
          "const": "score (0 or more); BCS = score / 5, rounded down",
          "default": "score (0 or more); BCS = score / 5, rounded down",
          "title": "Skill Value Meaning",
          "type": "string"
        },
        "derived_values": {
          "default": [
            {
              "name": "Current Attributes",
              "applies_to": "Main",
              "computed_from": "permanent value - attribute_loss; Deftness and Speed -50% when Seriously Wounded"
            },
            {
              "name": "Attribute Groups and Effect Dice",
              "applies_to": "Main",
              "computed_from": "current value, Attribute Group Chart"
            },
            {
              "name": "Attribute Saving Throws",
              "applies_to": "Main",
              "computed_from": "current value / 2, rounded down"
            },
            {
              "name": "Critical Saving Throws",
              "applies_to": "Main",
              "computed_from": "current value / 3"
            },
            {
              "name": "Basic Chance of Success",
              "applies_to": "skill",
              "computed_from": "skill score / 5, rounded down"
            },
            {
              "name": "Combat Dodge Ability",
              "applies_to": "character",
              "computed_from": "(current Deftness Group + current Speed Group) / 2"
            },
            {
              "name": "Weapon Defense Ability",
              "applies_to": "skill",
              "computed_from": "hand-to-hand BCS / 4"
            },
            {
              "name": "Damage Resistance Total",
              "applies_to": "character",
              "computed_from": "permanent Health + permanent Strength / 2 + permanent Will / 2"
            },
            {
              "name": "Seriously Wounded",
              "applies_to": "character",
              "computed_from": "Lethal + Subdual Damage > Damage Resistance Total / 2"
            },
            {
              "name": "Unconscious",
              "applies_to": "character",
              "computed_from": "Lethal + Subdual Damage > Damage Resistance Total"
            },
            {
              "name": "Dead",
              "applies_to": "character",
              "computed_from": "Lethal Damage > Damage Resistance Total + Health Group"
            },
            {
              "name": "Healing Rate",
              "applies_to": "character",
              "computed_from": "Health Group, modified by care and activity"
            },
            {
              "name": "Encumbrance Capacity",
              "applies_to": "character",
              "computed_from": "5 + Strength Attribute Saving Throw, in kg"
            },
            {
              "name": "Freely Improvable Skills Quota",
              "applies_to": "character",
              "computed_from": "current Wit + current Will"
            },
            {
              "name": "Learning Rate",
              "applies_to": "character",
              "computed_from": "Wit Group"
            },
            {
              "name": "Travel Rate",
              "applies_to": "character",
              "computed_from": "10 + current Speed, in km per day"
            },
            {
              "name": "Shock Factor",
              "applies_to": "character",
              "computed_from": "10 + Health Group"
            },
            {
              "name": "Size",
              "applies_to": "character",
              "computed_from": "height and weight category, Physical Aspects Chart"
            }
          ],
          "items": {
            "$ref": "#/$defs/DerivedValue"
          },
          "title": "Derived Values",
          "type": "array"
        },
        "attribute_loss": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "Wit",
              "Will",
              "Strength",
              "Deftness",
              "Speed",
              "Health"
            ]
          },
          "title": "Attribute Loss",
          "type": "object"
        },
        "attribute_progress": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "Wit",
              "Will",
              "Strength",
              "Deftness",
              "Speed",
              "Health"
            ]
          },
          "title": "Attribute Progress",
          "type": "object"
        },
        "critical_damage": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "Head",
              "Chest",
              "Mid body",
              "Lower body",
              "Upper right arm",
              "Upper left arm",
              "Right hand",
              "Left hand",
              "Upper right leg",
              "Upper left leg",
              "Lower right leg",
              "Lower left leg"
            ]
          },
          "title": "Critical Damage",
          "type": "object"
        },
        "luck_points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Luck Points"
        },
        "favored_hand": {
          "default": "right",
          "enum": [
            "right",
            "left"
          ],
          "title": "Favored Hand",
          "type": "string"
        },
        "height": {
          "default": "",
          "title": "Height",
          "type": "string"
        },
        "weight_kg": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        },
        "looks": {
          "default": "Average",
          "enum": [
            "Ugly",
            "Homely",
            "Mediocre",
            "Average",
            "Good Looking",
            "Comely",
            "Handsome"
          ],
          "title": "Looks",
          "type": "string"
        },
        "freely_improvable_skills": {
          "items": {
            "type": "string"
          },
          "title": "Freely Improvable Skills",
          "type": "array"
        },
        "hero_motivation": {
          "default": "",
          "title": "Hero Motivation",
          "type": "string"
        },
        "hero_method": {
          "default": "",
          "title": "Hero Method",
          "type": "string"
        },
        "hero_code": {
          "default": "",
          "title": "Hero Code",
          "type": "string"
        }
      },
      "required": [
        "system"
      ],
      "title": "SpecificValuesDaredevils",
      "type": "object"
    },
    "SpecificValuesDnD": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "dnd5e",
          "title": "System",
          "type": "string"
        },
        "skill_value_meaning": {
          "const": "proficiency level: 0 none, 1 proficient, 2 expertise",
          "default": "proficiency level: 0 none, 1 proficient, 2 expertise",
          "title": "Skill Value Meaning",
          "type": "string"
        },
        "derived_values": {
          "default": [
            {
              "name": "Total Level",
              "applies_to": "character",
              "computed_from": "sum of class levels"
            },
            {
              "name": "Current Ability Scores",
              "applies_to": "Main",
              "computed_from": "score - ability reduction"
            },
            {
              "name": "Ability Modifiers",
              "applies_to": "Main",
              "computed_from": "(current score - 10) // 2"
            },
            {
              "name": "Proficiency Bonus",
              "applies_to": "character",
              "computed_from": "2 + (total level - 1) // 4"
            },
            {
              "name": "Skill Bonuses",
              "applies_to": "skill",
              "computed_from": "ability modifier + proficiency level x proficiency bonus + other bonuses"
            },
            {
              "name": "Saving Throw Bonuses",
              "applies_to": "Main",
              "computed_from": "ability modifier + proficiency bonus if proficient + other bonuses"
            },
            {
              "name": "Armor Class",
              "applies_to": "character",
              "computed_from": "armor, shield, Dexterity, class features, race, items, active spells"
            },
            {
              "name": "Initiative",
              "applies_to": "character",
              "computed_from": "Dexterity modifier + other bonuses"
            },
            {
              "name": "Passive Perception",
              "applies_to": "character",
              "computed_from": "10 + Perception bonus"
            },
            {
              "name": "Spell Save DC",
              "applies_to": "character",
              "computed_from": "8 + proficiency bonus + spellcasting ability modifier"
            },
            {
              "name": "Spell Attack Bonus",
              "applies_to": "character",
              "computed_from": "proficiency bonus + spellcasting ability modifier"
            },
            {
              "name": "Spell Slots (maximum)",
              "applies_to": "character",
              "computed_from": "class levels, multiclass spellcaster table"
            },
            {
              "name": "Hit Dice (maximum)",
              "applies_to": "character",
              "computed_from": "one per class level, die size by class"
            }
          ],
          "items": {
            "$ref": "#/$defs/DerivedValue"
          },
          "title": "Derived Values",
          "type": "array"
        },
